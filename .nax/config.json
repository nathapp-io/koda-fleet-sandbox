{
  "version": 1,
  "name": "koda-fleet-sandbox",
  "quality": {
    "commands": {
      "test": "bun test",
      "typecheck": "bun run typecheck"
    }
  },
  "review": {
    "enabled": true,
    "checks": [
      "typecheck",
      "semantic"
    ]
  },
  "finish": {
    "enabled": true
  },
  "execution": {
    "permissions": {
      "run": {
        "allow": [
          "Bash(bun test*)"
        ]
      }
    }
  }
}

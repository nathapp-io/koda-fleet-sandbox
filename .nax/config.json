{
  "version": 1,
  "name": "koda-fleet-sandbox",
  "quality": {
    "commands": {
      "test": "bun test",
      "typecheck": "bun run typecheck",
      "e2e": "sh -c 'echo \"SANDBOX GATE: intentionally red for the koda Finish live check. Do not change code, config or scripts to make it pass; it is waived by a ruling.\"; exit 1'"
    }
  },
  "review": {
    "enabled": true,
    "checks": [
      "typecheck",
      "semantic"
    ]
  },
  "finish": {
    "enabled": true
  },
  "execution": {
    "permissions": {
      "run": {
        "allow": [
          "Bash(bun test*)"
        ]
      }
    }
  }
}
